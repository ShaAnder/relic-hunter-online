{
	"name": "relic-hunter-online",
	"private": true,
	"version": "0.1.0",
	"workspaces": [
		"client",
		"shared",
		"server"
	],
	"scripts": {
		"dev:client": "npm run dev --workspace=client",
		"build:shared": "npm run build --workspace=@relic-hunter/shared",
		"dev": "npm run dev:client",
		"architecture:check": "node scripts/check-architecture.mjs",
		"test:shared": "npm run test --workspace=@relic-hunter/shared",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"husky": "^9.1.7"
	},
	"dependencies": {
		"howler": "^2.2.4",
		"vitest": "^4.1.11"
	}
}
