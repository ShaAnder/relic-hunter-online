  "artDirection": {
    "name": "RHO Warm Material Style Lock",
    "intent": "Warm, stylized surfaces with broad hue variation, restrained detail, cool-plum shadows and warm highlights.",
    "rules": [
      "Prefer broad colour masses over high-frequency noise.",
      "Keep most variation inside the tile interior so adjacent variants do not create harsh seams.",
      "Use 3-5 related colours inside one tile rather than one flat fill.",
      "Reserve the strongest accent colour for very small coverage.",
      "Ground stays lower contrast than characters, props and barriers.",
      "Automatic variants communicate natural diversity, not authored gameplay state."
    ]
  },
